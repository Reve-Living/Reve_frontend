{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/product/:slug/",
      "destination": "/product/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/media/(.*)",
      "destination": "https://reve-backend.onrender.com/media/$1"
    },
    {
      "source": "/product/:slug",
      "destination": "/product/:slug.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index"
    }
  ]
}
